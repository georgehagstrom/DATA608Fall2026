# Quarto build artifacts
/website/.quarto/
/website/_site/
/website/_freeze/

# Local render output. The live site is published to the gh-pages branch by
# `quarto publish gh-pages` (Pages serves that branch, not main/docs), so the
# docs/ output-dir is just a local preview and stays untracked.
/docs/

# Rendered previews sitting next to sources
/website/**/*_files/
/planning/**/*_files/

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
.venv/
venv/
*.pyc

# OS cruft
.DS_Store
__MACOSX/
.Rhistory

# Archives - notably the Brightspace course export sitting in the repo root
# (D2LExport_*.zip, ~345MB). Keep it locally as the source of record; don't push it.
*.zip
*.tar
*.tgz

# Student submissions stay out of the public course repo
/StudentWork/

# Editor swap/backup files
.*.swp
.*.swo
*~
.Rproj.user
